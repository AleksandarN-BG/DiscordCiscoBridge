# Copy to .env and fill in. .env is gitignored; never commit it.

# Discord user token (self-bot). Treat as a password: it grants full account
# access. See the README's warning about Discord's Terms of Service.
DISCORD_USER_TOKEN=
# Optional: restrict to a single guild. Leave blank to allow all.
DISCORD_GUILD_ID=

# Cisco phone (CP-8845+) web interface.
# Addresses below are RFC 5737 documentation examples -- replace with your own.
PHONE_IP=192.0.2.10
PHONE_USERNAME=
PHONE_PASSWORD=

# This host, as the phone sees it. Must not be localhost -- the phone fetches
# its menus from HTTP_PUBLIC_URL over the network.
BRIDGE_IP=192.0.2.20
RTP_LISTEN_PORT=20480

# Binds 0.0.0.0 because the phone must reach it. Access is restricted by
# address instead: only PHONE_IP, loopback, and anything listed in
# HTTP_ALLOWED_CLIENTS are served. Never port-forward this.
HTTP_HOST=0.0.0.0

# Optional. Extra addresses allowed to reach the XML service, comma separated.
# Add a workstation here only while testing.
HTTP_ALLOWED_CLIENTS=
HTTP_PORT=8080
# Optional. Defaults to http://$BRIDGE_IP:$HTTP_PORT
HTTP_PUBLIC_URL=
